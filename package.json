{
  "name": "@filipsol/faster-ui",
  "description": "Faster UI - a small, accessible, token-driven React component library (Button, Input, Dialog).",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipsol/Faster-UI---DS.git"
  },
  "main": "./dist/faster-ui.cjs",
  "module": "./dist/faster-ui.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/faster-ui.mjs",
      "require": "./dist/faster-ui.cjs"
    },
    "./styles.css": "./dist/faster-ui.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.jest.json --noEmit && tsc -p tsconfig.cypress.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "cy:open": "cypress open --component",
    "cy:run": "cypress run --component",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cypress": "^15.20.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}

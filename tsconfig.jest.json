{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": ["jest", "node", "@testing-library/jest-dom"]
  },
  "include": ["src", "jest.setup.ts"],
  "exclude": ["src/**/*.cy.ts", "src/**/*.cy.tsx"]
}
